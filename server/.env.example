PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/verialert

# Optional LLM Provider (falls back to deterministic fallback if unset)
LLM_PROVIDER=fallback
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000

# Disaster Feed Ingestion (USGS Earthquake Hazards Program)
# Public GeoJSON feed — no API key required
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
INGESTION_TIMEOUT_MS=10000
INGESTION_MAX_RECORDS=100
