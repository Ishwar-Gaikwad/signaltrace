# ==============================================================================
# SignalTrace — Environment Configuration Template
# Disaster Information Verification Agent
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/verialert

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:5000/api

# Optional Language Model Provider for Claim Extraction
# When LLM_PROVIDER is not set or set to 'fallback', the deterministic sentence splitter is used.
LLM_PROVIDER=fallback
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_MS=8000
